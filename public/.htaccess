<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ==========================================
  # MAINTENANCE MODE
  # ==========================================
  # To enable maintenance mode, remove the '#' from the 3 lines below:
  # RewriteCond %{REQUEST_URI} !^/maintenance\.html$ [NC]
  # RewriteCond %{REQUEST_URI} !^/PageMaintanence\.png$ [NC]
  # RewriteRule ^(.*)$ /maintenance.html [R=503,L]
  #
  # Tell the server to properly recognize the 503 Service Unavailable status
  # ErrorDocument 503 /maintenance.html
  # ==========================================

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # HSTS (Strict-Transport-Security)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Enable XSS protection in legacy browsers
  Header always set X-XSS-Protection "1; mode=block"

  # Control referrer information
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Content Security Policy (CSP)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.sanity.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://cdn.sanity.io https://images.unsplash.com https://ceconline.edu; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.sanity.io https://*.api.sanity.io; frame-src 'self';"

  # Permissions Policy
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# Don't send the apache version number in error pages
ServerSignature Off
